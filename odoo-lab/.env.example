# Copia de referencia. NO pongas contraseñas reales aquí.
# Genera el .env real con:  ./scripts/init-secrets.sh
# (crea .env y config/odoo.conf con contraseñas aleatorias; ambos están en .gitignore)

# Usuario de PostgreSQL que usa Odoo (no puede llamarse "postgres" en Odoo 17)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambia-esto

# Contraseña maestra de Odoo (gestor de bases de datos /web/database/manager).
# El script la escribe en config/odoo.conf como admin_passwd.
ODOO_ADMIN_PASSWD=cambia-esto

# Puerto local en el que se publica Odoo
ODOO_PORT=8069
